# Copia este archivo como .env y llena cada valor. El .env real nunca se sube a Git.

# Cadena de conexión de Neon (PostgreSQL)
DATABASE_URL=postgresql://usuario:contrasena@servidor.neon.tech/neondb?sslmode=require

# Clave de Google AI Studio para la IA (Gemini)
GEMINI_API_KEY=
# Opcional: otro modelo de Gemini
# GEMINI_MODEL=gemini-3.5-flash-lite

# Secreto para firmar los tokens de sesión. Se genera con:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
CLAVE_TOKENS=

# Clave secreta de PRUEBA de Stripe (debe empezar con sk_test_)
STRIPE_SECRET_KEY=

# A dónde vuelve Stripe después de pagar
FRONTEND_URL=http://localhost:5173
