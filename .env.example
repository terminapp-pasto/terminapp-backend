# Copy this file to .env and fill in every value. The real .env is never committed.

# Neon (PostgreSQL) connection string
DATABASE_URL=postgresql://user:password@server.neon.tech/neondb?sslmode=require

# Google AI Studio key for the AI (Gemini)
GEMINI_API_KEY=
# Optional: another Gemini model
# GEMINI_MODEL=gemini-3.5-flash-lite

# Secret used to sign session tokens. Generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
TOKEN_SECRET=

# Stripe TEST secret key (must start with sk_test_)
STRIPE_SECRET_KEY=

# Optional: signing secret of the Stripe webhook (starts with whsec_). With it, a
# payment is confirmed even if the user closes the page before coming back.
# Stripe dashboard > Developers > Webhooks > endpoint .../stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Optional: extra allowed frontend origins (regular expression). The default only
# allows the Vercel site and http://localhost:5173.
# ALLOWED_ORIGINS_PATTERN=

# Where Stripe sends the user back after paying
FRONTEND_URL=http://localhost:5173

# Professor's test account (optional). Leave empty to skip it.
TEST_ACCOUNT_EMAIL=
TEST_ACCOUNT_PASSWORD=
# The company and traveler test accounts use the same password and, by default, the
# emails empresa.<TEST_ACCOUNT_EMAIL> and viajero.<TEST_ACCOUNT_EMAIL>.
# TEST_COMPANY_ACCOUNT_EMAIL=
# TEST_COMPANY_NAME=EXPRESO BOLIVARIANO
# TEST_TRAVELER_ACCOUNT_EMAIL=

# Optional extra admin account (the test account above is already an admin)
ADMIN_ACCOUNT_EMAIL=
ADMIN_ACCOUNT_PASSWORD=
